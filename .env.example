# Local development against the Firebase Emulator Suite (no real project needed).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-swcscanner
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key

# Read by firebase-admin and the sign-in route on the server
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Emulators need no Google credentials: skip the slow cloud metadata probe
METADATA_SERVER_DETECTION=none
