{
  "name": "swcscanner",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "predev": "bun scripts/copy-wasm.ts",
    "predev:lan": "bun scripts/copy-wasm.ts",
    "build": "next build",
    "prebuild": "bun scripts/copy-wasm.ts",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "emulators": "firebase emulators:start --import ./.emulator-data --export-on-exit ./.emulator-data",
    "seed": "bun --env-file=.env.development scripts/seed.ts",
    "setup:cloud": "bun --env-file=.env.production scripts/setup-cloud.ts",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes --project prod",
    "postinstall": "bun scripts/copy-wasm.ts"
  },
  "dependencies": {
    "barcode-detector": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.51.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
