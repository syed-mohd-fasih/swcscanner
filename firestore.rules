rules_version = '2';

// The browser never talks to Firestore directly: every read and write goes
// through the Next.js server (Admin SDK, which bypasses these rules), where
// server actions check the signed-in user's role. So clients get nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
